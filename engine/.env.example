# Copy to .env (or set in your environment). Defaults target the local dev stack.
PORT=54100
HOST=0.0.0.0

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=stigman
DB_PASSWORD=stigmanpw
DB_NAME=stigman_engine
DB_POOL_SIZE=10

# OIDC / Keycloak
OIDC_ISSUER=https://localhost/kc/realms/stigman
# OIDC_JWKS_URI=   # defaults to <issuer>/protocol/openid-connect/certs
# OIDC_AUDIENCE=
# DEV ONLY: accept the demo Keycloak's publicly-known signing key (no signature check)
ALLOW_INSECURE_TOKENS=true

CORS_ORIGIN=*
