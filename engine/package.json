{
  "name": "stigman-engine",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Standalone STIG compliance API + engine (ingest, metrics, remediation, CRUD) on Node + MySQL",
  "engines": { "node": ">=20" },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate": "tsx src/db/migrate.ts"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.1",
    "@fastify/multipart": "^9.0.1",
    "exceljs": "^4.4.0",
    "fast-xml-parser": "^4.5.0",
    "fastify": "^5.1.0",
    "jose": "^5.9.6",
    "mysql2": "^3.11.4",
    "node-cron": "^3.0.3",
    "prom-client": "^15.1.3",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.10.1",
    "@types/node-cron": "^3.0.11",
    "tsx": "^4.19.2",
    "typescript": "~5.6.3",
    "vitest": "^2.1.8"
  }
}
