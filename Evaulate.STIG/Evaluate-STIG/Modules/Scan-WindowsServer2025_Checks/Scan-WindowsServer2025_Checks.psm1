                        $Compliant = $false
                        $ResolvedObjects += $Object
                    }
                }
                Else {
                    $Compliant = $false
                    $ResolvedObjects += $Object
                }
            }
        }
        Else {
            If ($EmptyAllowed -ne $true) {
                $Compliant = $false
            }
            $ResolvedObjects += "No objects assigned to this right."
        }

