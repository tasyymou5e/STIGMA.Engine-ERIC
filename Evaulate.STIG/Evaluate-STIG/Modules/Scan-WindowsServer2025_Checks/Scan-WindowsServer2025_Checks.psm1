                            $NonCompliantACLDetails += "Expected:`t$($Rule.ExpectedBasicRights)" | Out-String
                            $NonCompliantACLDetails += "Advanced:`t$(($Rule.ActualCanonicalRights | Sort-Object) -join ', ')" | Out-String
                            $NonCompliantACLDetails += "Expected:`t$(($Rule.ExpectedCanonicalRights | Sort-Object) -join ', ')" | Out-String
                            $NonCompliantACLDetails += "Inherited:`t$($Rule.ActualInheritedFrom)" | Out-String
                            $NonCompliantACLDetails += "AppliesTo:`t$($Rule.ActualAppliesTo -join ', ')" | Out-String
                            $NonCompliantACLDetails += "Summary:`t$($Rule.Summary)" | Out-String
                            if ($i -lt ($UnexpectedRules | Measure-Object).Count) {
                                $NonCompliantACLDetails += "" | Out-String
                            }
                            $i++
                        }
                        $NonCompliantACLDetails += "---------------------" | Out-String
                    }
