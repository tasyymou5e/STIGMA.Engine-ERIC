        [Parameter(Mandatory = $false)]
        [String]$AnswerKey,

        [Parameter(Mandatory = $false)]
        [String]$Instance,

        [Parameter(Mandatory = $false)]
        [String]$Database,

        [Parameter(Mandatory = $false)]
        [String]$SiteName
    )

    $ModuleName = (Get-Command $MyInvocation.MyCommand).Source
    $FuncDescription = ($MyInvocation.MyCommand.ScriptBlock -split "#>")[0].split("`r`n")
    $VulnID = ($FuncDescription | Select-String -Pattern "V-\d{4,6}$").Matches[0].Value
    $RuleID = ($FuncDescription | Select-String -Pattern "SV-\d{4,6}r\d{1,}_rule$").Matches[0].Value
    $Status = "Not_Reviewed"  # Acceptable values are 'Not_Reviewed', 'Open', 'NotAFinding', 'Not_Applicable'
    $FindingDetails = ""
    $SeverityOverride = ""  # Acceptable values are 'CAT_I', 'CAT_II', 'CAT_III'.  Only use if STIG calls for a severity change based on specified critera.
    $Justification = ""  # If SeverityOverride is used, a justification is required.
    # $ResultObject = [System.Collections.Generic.List[System.Object]]::new()

    #---=== Begin Custom Code ===---#
    $PathsToEval = @("HKLM:\SECURITY", "HKLM:\SOFTWARE", "HKLM:\SYSTEM")
    $AllCompliant = $true

    ForEach ($Path in $PathsToEval) {
        Switch ($Path) {
            "HKLM:\SECURITY" {
                $AclToEval = @(
                    @{
                        IdentityReference = "NT AUTHORITY\SYSTEM"
                        AccessControlType = "Allow"
                        Inherited         = $false
                        BasicRights       = "FullControl"
                        AppliesTo         = @("This", "Subkeys")
                    },
                    @{
                        IdentityReference = "BUILTIN\Administrators"
                        AccessControlType = "Allow"
                        Inherited         = $false
                        CanonicalRights   = @("ReadPermissions", "ChangePermissions")
                        AppliesTo         = @("This", "Subkeys")
                    }
                )
            }
            "HKLM:\SOFTWARE" {
                $AclToEval = @(
                    @{
                        IdentityReference = "BUILTIN\Users"
                        AccessControlType = "Allow"
                        Inherited         = $false
                        BasicRights       = "Read"
                        AppliesTo         = @("This", "Subkeys")
                    },
                    @{
                        IdentityReference = "BUILTIN\Administrators"
                        AccessControlType = "Allow"
                        Inherited         = $false
                        BasicRights       = "FullControl"
                        AppliesTo         = @("This", "Subkeys")
                    },
                    @{
                        IdentityReference = "NT AUTHORITY\SYSTEM"
                        AccessControlType = "Allow"
                        Inherited         = $false
                        BasicRights       = "FullControl"
                        AppliesTo         = @("This", "Subkeys")
                    },
                    @{
                        IdentityReference = "CREATOR OWNER"
                        AccessControlType = "Allow"
                        Inherited         = $false
                        BasicRights       = "FullControl"
                        AppliesTo         = @("This", "Subkeys")
                    },
                    @{
                        IdentityReference = "APPLICATION PACKAGE AUTHORITY\ALL APPLICATION PACKAGES"
                        AccessControlType = "Allow"
                        Inherited         = $false
                        BasicRights       = "Read"
                        AppliesTo         = @("This", "Subkeys")
                    },
                    @{
                        IdentityReference = "S-1-15-3-1024-1065365936-1281604716-3511738428-1654721687-432734479-3232135806-4053264122-3456934681"
                        AccessControlType = "Allow"
                        Inherited         = $false
                        BasicRights       = "Read"
                        AppliesTo         = @("This", "Subkeys")
                        Optional          = $true
                    }
                )
            }
            "HKLM:\SYSTEM" {
                $AclToEval = @(
                    @{
                        IdentityReference = "BUILTIN\Administrators"
                        AccessControlType = "Allow"
                        Inherited         = $false
                        BasicRights       = "FullControl"
                        AppliesTo         = @("This", "Subkeys")
                    },
                    @{
                        IdentityReference = "NT AUTHORITY\SYSTEM"
                        AccessControlType = "Allow"
                        Inherited         = $false
                        BasicRights       = "FullControl"
                        AppliesTo         = @("This", "Subkeys")
                    },
                    @{
                        IdentityReference = "CREATOR OWNER"
                        AccessControlType = "Allow"
                        Inherited         = $false
                        BasicRights       = "FullControl"
                        AppliesTo         = @("This", "Subkeys")
                    },
                    @{
                        IdentityReference = "APPLICATION PACKAGE AUTHORITY\ALL APPLICATION PACKAGES"
                        AccessControlType = "Allow"
                        Inherited         = $false
                        BasicRights       = "Read"
                        AppliesTo         = @("This", "Subkeys")
                    },
                    @{
                        IdentityReference = "S-1-15-3-1024-1065365936-1281604716-3511738428-1654721687-432734479-3232135806-4053264122-3456934681"
                        AccessControlType = "Allow"
                        Inherited         = $false
                        BasicRights       = "Read"
                        AppliesTo         = @("This", "Subkeys")
                        Optional          = $true
                    }
                )
                if ((Get-DomainRoleStatus).RoleFriendlyName -in @("Backup Domain Controller", "Primary Domain Controller")) {
                    # Domain controllers have 'Authenticate Users' instead of 'Users' and add 'Server Operators
                    $AclToEval += @{
                        IdentityReference = "NT AUTHORITY\Authenticated Users"
                        AccessControlType = "Allow"
                        Inherited         = $false
                        BasicRights       = "Read"
                        AppliesTo         = @("This", "Subkeys")
                    }
                    $AclToEval += @{
                        IdentityReference = "BUILTIN\Server Operators"
                        AccessControlType = "Allow"
                        Inherited         = $false
                        BasicRights       = "Read"
                        AppliesTo         = @("This", "Subkeys")
                    }
                }
                else {
                    # STIG states that "NT AUTHORITY\Authenticated Users" is OS default but in actuality, it is "BUILTIN\Users" on member servers and stand-alone servers.
                    $AclToEval += @{
                        IdentityReference = "BUILTIN\Users"
                        AccessControlType = "Allow"
                        Inherited         = $false
                        BasicRights       = "Read"
                        AppliesTo         = @("This", "Subkeys")
                    }
                }
            }
        }

        $AclCheck = Test-AclCompliance -Path $Path -ExpectedAcl $AclToEval

        $FindingDetails += "Path:`t`t`t$($Path)" | Out-String
        switch ($AclCheck.OverallState) {
            "Same" {
                $FindingDetails += "OverallState:`tExpected permissions in place" | Out-String
                $FindingDetails += "Compliance:`tCompliant" | Out-String
            }
            {$_ -in @("MoreRestrictive", "LessRestrictive")} {
                $UnexpectedRules = $AclCheck.Details.Access | Where-Object {$_.ActualState -in @("MoreRestrictive", "LessRestrictive")}
                If ($_ -eq "MoreRestrictive") {
                    $FindingDetails += "OverallState:`tMore restrictive than Expected" | Out-String
                    $FindingDetails += "Compliance:`tCompliant" | Out-String
                }
                Else {
                    $AllCompliant = $false
                    $FindingDetails += "OverallState:`tLess restrictive than Expected [finding]" | Out-String
                    $FindingDetails += "Compliance:`tNot Compliant" | Out-String
                }
                $FindingDetails += "Unexpected rules..." | Out-String
                $i = 1
                $FindingDetails += "---------------------" | Out-String
                foreach ($Rule in $UnexpectedRules) {
                    $FindingDetails += "State:`t`t$($Rule.ActualState)" | Out-String
                    if ($Rule.ActualState -eq "LessRestrictive") {
                        $FindingDetails += "Compliant:`t$($false)" | Out-String
                    }
                    else {
                        $FindingDetails += "Compliant:`t$($true)" | Out-String
                    }
                    $FindingDetails += "Identity:`t`t$($Rule.IdentityReference)" | Out-String
                    $FindingDetails += "Type:`t`t$($Rule.ActualAccessControlType)" | Out-String
                    $FindingDetails += "Basic:`t`t$($Rule.ActualBasicRights)" | Out-String
                    $FindingDetails += "Expected:`t`t$($Rule.ExpectedBasicRights)" | Out-String
                    $FindingDetails += "Advanced:`t$(($Rule.ActualCanonicalRights | Sort-Object) -join ', ')" | Out-String
                    $FindingDetails += "Expected:`t`t$(($Rule.ExpectedCanonicalRights | Sort-Object) -join ', ')" | Out-String
                    $FindingDetails += "Inherited:`t`t$($Rule.ActualInheritedFrom)" | Out-String
                    $FindingDetails += "AppliesTo:`t$($Rule.ActualAppliesTo -join ', ')" | Out-String
                    $FindingDetails += "Summary:`t`t$($Rule.Summary)" | Out-String
                    if ($i -lt ($UnexpectedRules | Measure-Object).Count) {
                        $FindingDetails += "" | Out-String
                    }
                    $i++
                }
                $FindingDetails += "---------------------" | Out-String
            }
        }
        $FindingDetails += "" | Out-String
    }

    If ($AllCompliant -eq $true) {
        $Status = "NotAFinding"
    }
    Else {
        $Status = "Open"
    }
    #---=== End Custom Code ===---#

    if ($FindingDetails.Trim().Length -gt 0) {
        $ResultHash = Get-TextHash -Text $FindingDetails.Trim() -Algorithm SHA1
    }
    else {
        if  ($Status -ne "Not_Reviewed") {
            throw "Attempt to set Status without providing Finding Details."
        }
        $ResultHash = ""
    }

    if ($PSBoundParameters.AnswerFile) {
        $GetCorpParams = @{
            AnswerFile   = $PSBoundParameters.AnswerFile
            VulnID       = $VulnID
            RuleID       = $RuleID
            AnswerKey    = $PSBoundParameters.AnswerKey
            Status       = $Status.Trim()
            Hostname     = $Hostname
            Username     = $Username
            UserSID      = $UserSID
            Instance     = $Instance
            Database     = $Database
            Site         = $Site
            ResultHash   = $ResultHash
            ResultData   = $FindingDetails.Trim()
            ShowRun      = $ShowRunningConfig
            ESPath       = $ESPath
            LogPath      = $LogPath
            LogComponent = $LogComponent
            OSPlatform   = $OSPlatform
        }

        $AnswerData = (Get-CorporateComment @GetCorpParams)
        if ($Status -eq $AnswerData.ExpectedStatus) {
            $SendAnswerData = $AnswerData
        }
    }

    $SendCheckParams = @{
        Module           = $ModuleName
        Status           = $Status.Trim()
        FindingDetails   = $FindingDetails.Trim()
        AnswerData       = $SendAnswerData
        SeverityOverride = $SeverityOverride
        Justification    = $Justification
        HeadInstance     = $Instance
        HeadDatabase     = $Database
        HeadSite         = $Site
        HeadHash         = $ResultHash
    }
    if ($AF_UserHeader) {
        $SendCheckParams.Add("HeadUsername", $Username)
        $SendCheckParams.Add("HeadUserSID", $UserSID)
    }

    return Send-CheckResult @SendCheckParams
}

Function Get-V278002 {
    <#
    .DESCRIPTION
        Vuln ID    : V-278002
        STIG ID    : WN25-00-000180
        Rule ID    : SV-278002r1181785_rule
        CCI ID     : CCI-000213
        Rule Name  : SRG-OS-000080-GPOS-00048
        Rule Title : Windows Server 2025 nonadministrative accounts or groups must only have print permissions on printer shares.
        DiscussMD5 : B54847BD12077E77DBA22F6236680927
        CheckMD5   : 2675568237B1630EAE6D36193C51B91A
        FixMD5     : 37BEA3D65A19C460006643D4B901B19D
    #>

    param (
        [Parameter(Mandatory = $true)]
        [String]$ScanType,

        [Parameter(Mandatory = $false)]
        [String]$AnswerFile,

        [Parameter(Mandatory = $false)]
        [String]$AnswerKey,

        [Parameter(Mandatory = $false)]
        [String]$Instance,

        [Parameter(Mandatory = $false)]
        [String]$Database,

        [Parameter(Mandatory = $false)]
        [String]$SiteName
    )

    $ModuleName = (Get-Command $MyInvocation.MyCommand).Source
    $FuncDescription = ($MyInvocation.MyCommand.ScriptBlock -split "#>")[0].split("`r`n")
    $VulnID = ($FuncDescription | Select-String -Pattern "V-\d{4,6}$").Matches[0].Value
    $RuleID = ($FuncDescription | Select-String -Pattern "SV-\d{4,6}r\d{1,}_rule$").Matches[0].Value
    $Status = "Not_Reviewed"  # Acceptable values are 'Not_Reviewed', 'Open', 'NotAFinding', 'Not_Applicable'
    $FindingDetails = ""
    $SeverityOverride = ""  # Acceptable values are 'CAT_I', 'CAT_II', 'CAT_III'.  Only use if STIG calls for a severity change based on specified critera.
    $Justification = ""  # If SeverityOverride is used, a justification is required.
    # $ResultObject = [System.Collections.Generic.List[System.Object]]::new()

    #---=== Begin Custom Code ===---#
    $ValidPrinters = Get-CimInstance Win32_Printer -ErrorAction SilentlyContinue | Where-Object { ($_.DriverName -notmatch "Microsoft Print To PDF") -and ($_.DriverName -notmatch "Microsoft XPS Document Writer") }
    If (-Not($ValidPrinters)) {
        $Status = "Not_Applicable"
        $FindingDetails += "No printers are configured on this server so this requirement is NA." | Out-String
    }
    ElseIf (-Not($ValidPrinters | Where-Object Shared -EQ $true)) {
        $Status = "NotAFinding"
        $FindingDetails += "No printers are shared on this server." | Out-String
    }
    Else {
        If (($PsVersionTable.PSVersion -join ".") -lt [Version]"6.0") {
            Import-Module PrintManagement
        }
        Else {
            Import-Module PrintManagement -SkipEditionCheck
        }

        ForEach ($Printer in ($ValidPrinters | Where-Object Shared -EQ $true)) {
            $FindingDetails += "Printer Name:`t$($Printer.Name)" | Out-String
            $FindingDetails += "Shared:`t`tTrue" | Out-String
            $FindingDetails += "------------------------" | Out-String
            Try {
                $Acl = ((Get-Printer -Name $Printer.Name -Full).PermissionSDDL | ConvertFrom-SddlString -ErrorAction Stop).DiscretionaryAcl
                ForEach ($Item in $Acl) {
                    $ItemSplit = ($Item -split ":").Trim()
                    $Principal = $ItemSplit[0]
                    If ($Principal -eq "") {
                        $Principal = "Unknown Account"
                    }
                    $Type = ($ItemSplit[1] -split "\(")[0].Trim()
                    $Access = (($ItemSplit[1] -split "\(")[1].Trim() -replace "\)", "" -split ",").Trim()
                    $ConvertedAccess = @()
                    # Print
                    If ($Access -match "ReadExtendedAttributes") {
                        $ConvertedAccess += "Print"
                    }

                    # Manage printer
                    If ($Access -contains "CreateDirectories" -and $Access -contains "Delete") {
                        $ConvertedAccess += "Manage printer"
                    }

                    # Manage documents
                    If ($Access -contains "Delete" -and $Access -notcontains "CreateDirectories") {
                        $ConvertedAccess += "Manage documents"
                    }

                    # Read permissions
                    If ($Access -contains "ReadPermissions") {
                        $ConvertedAccess += "Read permissions"
                    }

                    # Change permissions
                    If ($Access -contains "ChangePermissions") {
                        $ConvertedAccess += "Change permissions"
                    }

                    # Take ownership
                    If ($Access -contains "TakeOwnership") {
                        $ConvertedAccess += "Take ownership"
                    }

                    $FindingDetails += "Principal:`t`t$($Principal)" | Out-String
                    $FindingDetails += "Type:`t`t$($Type)" | Out-String
                    $FindingDetails += "Access:`t`t$($ConvertedAccess -join ", ")" | Out-String
                    $FindingDetails += "" | Out-String
                }
            }
            Catch {
                $FindingDetails += "Unable to read permissions" | Out-String
                $FindingDetails += "" | Out-String
            }
            $FindingDetails += "------------------------" | Out-String
            $FindingDetails += "" | Out-String
        }
    }
    #---=== End Custom Code ===---#

    if ($FindingDetails.Trim().Length -gt 0) {
        $ResultHash = Get-TextHash -Text $FindingDetails.Trim() -Algorithm SHA1
    }
    else {
        if  ($Status -ne "Not_Reviewed") {
            throw "Attempt to set Status without providing Finding Details."
        }
        $ResultHash = ""
    }

    if ($PSBoundParameters.AnswerFile) {
        $GetCorpParams = @{
            AnswerFile   = $PSBoundParameters.AnswerFile
            VulnID       = $VulnID
            RuleID       = $RuleID
            AnswerKey    = $PSBoundParameters.AnswerKey
            Status       = $Status.Trim()
            Hostname     = $Hostname
            Username     = $Username
            UserSID      = $UserSID
            Instance     = $Instance
            Database     = $Database
            Site         = $Site
            ResultHash   = $ResultHash
            ResultData   = $FindingDetails.Trim()
            ShowRun      = $ShowRunningConfig
            ESPath       = $ESPath
            LogPath      = $LogPath
            LogComponent = $LogComponent
            OSPlatform   = $OSPlatform
        }

        $AnswerData = (Get-CorporateComment @GetCorpParams)
        if ($Status -eq $AnswerData.ExpectedStatus) {
            $SendAnswerData = $AnswerData
        }
    }

    $SendCheckParams = @{
        Module           = $ModuleName
        Status           = $Status.Trim()
        FindingDetails   = $FindingDetails.Trim()
        AnswerData       = $SendAnswerData
        SeverityOverride = $SeverityOverride
        Justification    = $Justification
        HeadInstance     = $Instance
        HeadDatabase     = $Database
        HeadSite         = $Site
        HeadHash         = $ResultHash
    }
    if ($AF_UserHeader) {
        $SendCheckParams.Add("HeadUsername", $Username)
        $SendCheckParams.Add("HeadUserSID", $UserSID)
    }

    return Send-CheckResult @SendCheckParams
}

Function Get-V278003 {
    <#
    .DESCRIPTION
        Vuln ID    : V-278003
        STIG ID    : WN25-00-000190
        Rule ID    : SV-278003r1182254_rule
        CCI ID     : CCI-003627, CCI-003628
        Rule Name  : SRG-OS-000118-GPOS-00060
        Rule Title : Outdated or unused accounts on Windows Server 2025 must be removed or disabled.
        DiscussMD5 : DA8C4A6D4E374DD6DBF16E8CE1F8503E
        CheckMD5   : ACAE2364F646B6F58E1EED95C77747DA
        FixMD5     : 90C181AF4600F5450AAF292C5662E995
    #>

    param (
        [Parameter(Mandatory = $true)]
        [String]$ScanType,

        [Parameter(Mandatory = $false)]
        [String]$AnswerFile,

        [Parameter(Mandatory = $false)]
        [String]$AnswerKey,

        [Parameter(Mandatory = $false)]
        [String]$Instance,

        [Parameter(Mandatory = $false)]
        [String]$Database,

        [Parameter(Mandatory = $false)]
        [String]$SiteName
    )

    $ModuleName = (Get-Command $MyInvocation.MyCommand).Source
    $FuncDescription = ($MyInvocation.MyCommand.ScriptBlock -split "#>")[0].split("`r`n")
    $VulnID = ($FuncDescription | Select-String -Pattern "V-\d{4,6}$").Matches[0].Value
    $RuleID = ($FuncDescription | Select-String -Pattern "SV-\d{4,6}r\d{1,}_rule$").Matches[0].Value
    $Status = "Not_Reviewed"  # Acceptable values are 'Not_Reviewed', 'Open', 'NotAFinding', 'Not_Applicable'
    $FindingDetails = ""
    $SeverityOverride = ""  # Acceptable values are 'CAT_I', 'CAT_II', 'CAT_III'.  Only use if STIG calls for a severity change based on specified critera.
    $Justification = ""  # If SeverityOverride is used, a justification is required.
    # $ResultObject = [System.Collections.Generic.List[System.Object]]::new()

    #---=== Begin Custom Code ===---#
    $UsersToIgnore = @("*-500","*-501")
    $AccountsToIgnore = New-Object System.Collections.Generic.List[System.Object]
    $BadAccounts = New-Object System.Collections.Generic.List[System.Object]

    $DomainRole = Get-DomainRoleStatus
    If ($DomainRole.RoleFriendlyName -in @("Backup Domain Controller", "Primary Domain Controller")) {
        Search-ADAccount -AccountInactive -UsersOnly -TimeSpan 35.00:00:00 | Where-Object Enabled -eq $true | ForEach-Object {
            If (-Not($_.LastLogonDate)) {
                $LastLogon = "Never"
            }
            Else {
                $LastLogon = "$($_.LastLogonDate) [$((New-TimeSpan -Start $_.LastLogonDate -End (Get-Date)).Days) days]"
            }
            $IgnoreUser = $false
            ForEach ($Item in $UsersToIgnore) {
                If ($_.SID -like $Item -or $_.Name -like $Item) {
                    $IgnoreUser = $true
                }
            }
            If ($IgnoreUser -eq $true) {
                $NewObj = [PSCustomObject]@{
                    Name      = $_.Name
                    Enabled   = $_.Enabled
                    SID       = $_.SID
                    LastLogon = $LastLogon
                }
                $AccountsToIgnore.Add($NewObj)
            }
            Else {
                $NewObj = [PSCustomObject]@{
                    Name      = $_.Name
                    Enabled   = $_.Enabled
                    SID       = $_.SID
                    LastLogon = $LastLogon
                }
                $BadAccounts.Add($NewObj)
            }
        }
    }
    Else {
        Get-LocalUser | Where-Object {($_.Enabled -eq $true) -and ($_.LastLogon -le (Get-Date).AddDays(-35))} | ForEach-Object {
            If (-Not($_.LastLogon)) {
                $LastLogon = "Never"
            }
            Else {
                $LastLogon = "$($_.LastLogon) [$((New-TimeSpan -Start $_.LastLogon -End (Get-Date)).Days) days]"
            }
            $IgnoreUser = $false
            ForEach ($Item in $UsersToIgnore) {
                If ($_.SID -like $Item -or $_.Name -like $Item) {
                    $IgnoreUser = $true
                }
            }
            If ($IgnoreUser -eq $true) {
                $NewObj = [PSCustomObject]@{
                    Name      = $_.Name
                    Enabled   = $_.Enabled
                    SID       = $_.SID
                    LastLogon = $LastLogon
                }
                $AccountsToIgnore.Add($NewObj)
            }
            Else {
                $NewObj = [PSCustomObject]@{
                    Name      = $_.Name
                    Enabled   = $_.Enabled
                    SID       = $_.SID
                    LastLogon = $LastLogon
                }
                $BadAccounts.Add($NewObj)
            }
        }
    }

    If (($AccountsToIgnore | Measure-Object).Count -ge 1) {
        $FindingDetails += "Ignored Accounts:" | Out-String
        $FindingDetails += "---------------------" | Out-String
        ForEach ($Object in $AccountsToIgnore) {
            $FindingDetails += "Name:`t`t$($Object.Name)" | Out-String
            $FindingDetails += "SID:`t`t`t$($Object.SID)" | Out-String
            $FindingDetails += "Enabled:`t`t$($Object.Enabled)" | Out-String
            $FindingDetails += "Last Logon:`t$($Object.LastLogon)" | Out-String
            $FindingDetails += "" | Out-String
        }
        $FindingDetails += "" | Out-String
    }

    If (($BadAccounts | Measure-Object).Count -ge 1) {
        $FindingDetails += "Failed accounts:" | Out-String
        $FindingDetails += "---------------------" | Out-String
        ForEach ($Object in $BadAccounts) {
            $FindingDetails += "Name:`t`t$($Object.Name)" | Out-String
            $FindingDetails += "SID:`t`t`t$($Object.SID)" | Out-String
            $FindingDetails += "Enabled:`t`t$($Object.Enabled)" | Out-String
            $FindingDetails += "Last Logon:`t$($Object.LastLogon)" | Out-String
            $FindingDetails += "" | Out-String
        }
    }
    Else {
        $Status = "NotAFinding"
        $FindingDetails += "No enabled accounts found that have not logged on within 35 days." | Out-String
    }
    #---=== End Custom Code ===---#

    if ($FindingDetails.Trim().Length -gt 0) {
        $ResultHash = Get-TextHash -Text $FindingDetails.Trim() -Algorithm SHA1
    }
    else {
        if  ($Status -ne "Not_Reviewed") {
            throw "Attempt to set Status without providing Finding Details."
        }
        $ResultHash = ""
    }

    if ($PSBoundParameters.AnswerFile) {
        $GetCorpParams = @{
            AnswerFile   = $PSBoundParameters.AnswerFile
            VulnID       = $VulnID
            RuleID       = $RuleID
            AnswerKey    = $PSBoundParameters.AnswerKey
            Status       = $Status.Trim()
            Hostname     = $Hostname
            Username     = $Username
            UserSID      = $UserSID
            Instance     = $Instance
            Database     = $Database
            Site         = $Site
            ResultHash   = $ResultHash
            ResultData   = $FindingDetails.Trim()
            ShowRun      = $ShowRunningConfig
            ESPath       = $ESPath
            LogPath      = $LogPath
            LogComponent = $LogComponent
            OSPlatform   = $OSPlatform
        }

        $AnswerData = (Get-CorporateComment @GetCorpParams)
        if ($Status -eq $AnswerData.ExpectedStatus) {
            $SendAnswerData = $AnswerData
        }
    }

    $SendCheckParams = @{
        Module           = $ModuleName
        Status           = $Status.Trim()
        FindingDetails   = $FindingDetails.Trim()
        AnswerData       = $SendAnswerData
        SeverityOverride = $SeverityOverride
        Justification    = $Justification
        HeadInstance     = $Instance
        HeadDatabase     = $Database
        HeadSite         = $Site
        HeadHash         = $ResultHash
    }
    if ($AF_UserHeader) {
        $SendCheckParams.Add("HeadUsername", $Username)
        $SendCheckParams.Add("HeadUserSID", $UserSID)
    }

    return Send-CheckResult @SendCheckParams
}

