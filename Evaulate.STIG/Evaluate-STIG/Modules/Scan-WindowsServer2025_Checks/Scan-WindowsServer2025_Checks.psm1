Function Get-V278007 {
    <#
    .DESCRIPTION
        Vuln ID    : V-278007
        STIG ID    : WN25-00-000230
        Rule ID    : SV-278007r1181789_rule
        CCI ID     : CCI-001090
        Rule Name  : SRG-OS-000138-GPOS-00069
        Rule Title : Windows Server 2025 nonsystem-created file shares must limit access to groups that require it.
        DiscussMD5 : E0C0DF614EF4A05CE3351F0258ECA237
        CheckMD5   : F6CE6B81FBE7505BA5CF706FC4214DB8
        FixMD5     : AAF27CA5E9EBE585C15881530A79BACF
    #>

    param (
        [Parameter(Mandatory = $true)]
        [String]$ScanType,

        [Parameter(Mandatory = $false)]
        [String]$AnswerFile,

        [Parameter(Mandatory = $false)]
        [String]$AnswerKey,

        [Parameter(Mandatory = $false)]
        [String]$Instance,

        [Parameter(Mandatory = $false)]
        [String]$Database,

        [Parameter(Mandatory = $false)]
        [String]$SiteName
    )

    $ModuleName = (Get-Command $MyInvocation.MyCommand).Source
    $FuncDescription = ($MyInvocation.MyCommand.ScriptBlock -split "#>")[0].split("`r`n")
    $VulnID = ($FuncDescription | Select-String -Pattern "V-\d{4,6}$").Matches[0].Value
    $RuleID = ($FuncDescription | Select-String -Pattern "SV-\d{4,6}r\d{1,}_rule$").Matches[0].Value
    $Status = "Not_Reviewed"  # Acceptable values are 'Not_Reviewed', 'Open', 'NotAFinding', 'Not_Applicable'
    $FindingDetails = ""
    $SeverityOverride = ""  # Acceptable values are 'CAT_I', 'CAT_II', 'CAT_III'.  Only use if STIG calls for a severity change based on specified critera.
    $Justification = ""  # If SeverityOverride is used, a justification is required.
    # $ResultObject = [System.Collections.Generic.List[System.Object]]::new()

    #---=== Begin Custom Code ===---#
    # Per DISA ticket STS-028787: NETLOGON, SYSVOL, and Print$ are also system-created shares
    $SystemShareNames = @("Print$")
    if ((Get-DomainRoleStatus).RoleFriendlyName -in @("Backup Domain Controller", "Primary Domain Controller")) {
        $SystemShareNames += @("NETLOGON", "SYSVOL")
    }
    $Shares = Get-CimInstance Win32_Share | Where-Object {$_.Type -eq 0 -and $_.Name -notin $SystemShareNames} | Select-Object Name, Path
    If (-Not($Shares)) {
        $Status = "Not_Applicable"
        $FindingDetails += "Only system-created shares exist on this system so this requirement is NA." | Out-String
    }
    Else {
        $FindingDetails += "The following non-system-created shares have been identified.  Verify permissions for each is appropriate:" | Out-String
        $FindingDetails += "" | Out-String

        ForEach ($Share in $Shares) {
            $FindingDetails += "Name:`t$($Share.Name)" | Out-String
            $FindingDetails += "Path:`t$($Share.Path)" | Out-String
            $FindingDetails += "---------------------" | Out-String

            # Get share permissions
            $FindingDetails += "Share Permissions:" | Out-String
            $NetShare = NET SHARE $($Share.Name)
            $Permissions = $NetShare[[array]::IndexOf($NetShare, ($netShare | Select-String "Permission"))..($NetShare.Length - 4)] -replace "Permission", ""
            ForEach ($Item in $Permissions) {
                $FindingDetails += "Right: $($Item.Trim())" | Out-String
            }

            # Get NTFS permissions
            $FindingDetails += "" | Out-String
            $FindingDetails += "NTFS Permissions:" | Out-String
            $i = 1
            If ($Null -ne $Share.Path) {
                $ACLs = Test-AclCompliance $Share.Path
                ForEach ($ACL in $ACLs) {
                    $FindingDetails += "Identity:`t`t$($ACL.IdentityReference)" | Out-String
                    $FindingDetails += "Type:`t`t$($ACL.AccessControlType)" | Out-String
                    $FindingDetails += "Basic:`t`t$($ACL.BasicRights)" | Out-String
                    $FindingDetails += "Inherited:`t`t$($ACL.InheritedFrom)" | Out-String
                    $FindingDetails += "AppliesTo:`t$($ACL.AppliesTo -join ', ')" | Out-String
                    if ($i -lt ($ACLs | Measure-Object).Count) {
                        $FindingDetails += "" | Out-String
                    }
                    $i++
                }
                $FindingDetails += "---------------------" | Out-String
            }
        }
    }
    #---=== End Custom Code ===---#

    if ($FindingDetails.Trim().Length -gt 0) {
        $ResultHash = Get-TextHash -Text $FindingDetails.Trim() -Algorithm SHA1
    }
    else {
        if  ($Status -ne "Not_Reviewed") {
            throw "Attempt to set Status without providing Finding Details."
        }
        $ResultHash = ""
    }

    if ($PSBoundParameters.AnswerFile) {
        $GetCorpParams = @{
            AnswerFile   = $PSBoundParameters.AnswerFile
            VulnID       = $VulnID
            RuleID       = $RuleID
            AnswerKey    = $PSBoundParameters.AnswerKey
            Status       = $Status.Trim()
            Hostname     = $Hostname
            Username     = $Username
            UserSID      = $UserSID
            Instance     = $Instance
            Database     = $Database
            Site         = $Site
            ResultHash   = $ResultHash
            ResultData   = $FindingDetails.Trim()
            ShowRun      = $ShowRunningConfig
            ESPath       = $ESPath
            LogPath      = $LogPath
            LogComponent = $LogComponent
            OSPlatform   = $OSPlatform
        }

        $AnswerData = (Get-CorporateComment @GetCorpParams)
        if ($Status -eq $AnswerData.ExpectedStatus) {
            $SendAnswerData = $AnswerData
        }
    }

    $SendCheckParams = @{
        Module           = $ModuleName
        Status           = $Status.Trim()
        FindingDetails   = $FindingDetails.Trim()
        AnswerData       = $SendAnswerData
        SeverityOverride = $SeverityOverride
        Justification    = $Justification
        HeadInstance     = $Instance
        HeadDatabase     = $Database
        HeadSite         = $Site
        HeadHash         = $ResultHash
    }
    if ($AF_UserHeader) {
        $SendCheckParams.Add("HeadUsername", $Username)
        $SendCheckParams.Add("HeadUserSID", $UserSID)
    }

    return Send-CheckResult @SendCheckParams
}

