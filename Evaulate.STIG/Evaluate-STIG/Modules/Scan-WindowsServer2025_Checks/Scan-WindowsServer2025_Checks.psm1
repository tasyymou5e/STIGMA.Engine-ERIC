    $RuleID = ($FuncDescription | Select-String -Pattern "SV-\d{4,6}r\d{1,}_rule$").Matches[0].Value
    $Status = "Not_Reviewed"  # Acceptable values are 'Not_Reviewed', 'Open', 'NotAFinding', 'Not_Applicable'
    $FindingDetails = ""
    $SeverityOverride = ""  # Acceptable values are 'CAT_I', 'CAT_II', 'CAT_III'.  Only use if STIG calls for a severity change based on specified critera.
    $Justification = ""  # If SeverityOverride is used, a justification is required.
    # $ResultObject = [System.Collections.Generic.List[System.Object]]::new()

    #---=== Begin Custom Code ===---#
    $DomainRole = Get-DomainRoleStatus
    If (-Not($DomainRole.RoleFriendlyName -in @("Backup Domain Controller", "Primary Domain Controller"))) {
        $Status = "Not_Applicable"
        $FindingDetails += "System is a '$($DomainRole.RoleFriendlyName)' so this requirement is NA." | Out-String
    }
    Else {
        $SysVolLocation = (Get-ItemProperty -Path "HKLM:\System\CurrentControlSet\Services\Netlogon\Parameters").SysVol #Sysvol path

        If ($SysVolLocation -match "\\SYSVOL\\sysvol") {
            $SysVolLocation = $SysVolLocation.Replace("\SYSVOL\sysvol", "\SYSVOL\") #Replace as per the STIG
        }

        $PathsToEval = @("$SysVolLocation")
        $AllCompliant = $true

        ForEach ($Path in $PathsToEval) {
            If (Test-Path $Path) {
                $AclToEval = @(
                    @{
                        IdentityReference = "NT AUTHORITY\Authenticated Users"
                        AccessControlType = "Allow"
                        Inherited         = $false
                        BasicRights       = "ReadAndExecute"
                        AppliesTo         = @("This", "Subfolders", "Files")
                    },
                    @{
                        IdentityReference = "BUILTIN\Server Operators"
                        AccessControlType = "Allow"
                        Inherited         = $false
                        BasicRights       = "ReadAndExecute"
                        AppliesTo         = @("This", "Subfolders", "Files")
                    },
                    @{
                        IdentityReference = "BUILTIN\Administrators"
                        AccessControlType = "Allow"
                        Inherited         = $false
                        BasicRights       = "FullControl"
                        AppliesTo         = @("Subfolders", "Files")
                    },
                    @{
                        IdentityReference = "BUILTIN\Administrators"
                        AccessControlType = "Allow"
                        Inherited         = $false
                        CanonicalRights   = @("AppendData", "ChangePermissions", "CreateDirectories", "CreateFiles", "Delete", "ExecuteFile", "ListDirectory", "ReadAttributes", "ReadData", "ReadExtendedAttributes", "ReadPermissions", "TakeOwnership", "Traverse", "WriteAttributes", "WriteData", "WriteExtendedAttributes")
                        AppliesTo         = @("This")
                    },
                    @{
                        IdentityReference = "CREATOR OWNER"
                        AccessControlType = "Allow"
                        Inherited         = $false
                        BasicRights       = "FullControl"
                        AppliesTo         = @("Subfolders", "Files")
                    },
                    @{
                        IdentityReference = "NT AUTHORITY\SYSTEM"
                        AccessControlType = "Allow"
                        Inherited         = $false
                        BasicRights       = "FullControl"
                        AppliesTo         = @("This", "Subfolders", "Files")
                    }
                )

                $AclCheck = Test-AclCompliance -Path $Path -ExpectedAcl $AclToEval

                $FindingDetails += "Path:`t`t`t$($Path)" | Out-String
                switch ($AclCheck.OverallState) {
                    "Same" {
                        $FindingDetails += "OverallState:`tExpected permissions in place" | Out-String
                        $FindingDetails += "Compliance:`tCompliant" | Out-String
                    }
                    {$_ -in @("MoreRestrictive", "LessRestrictive")} {
                        $UnexpectedRules = $AclCheck.Details.Access | Where-Object {$_.ActualState -in @("MoreRestrictive", "LessRestrictive")}
                        If ($_ -eq "MoreRestrictive") {
                            $FindingDetails += "OverallState:`tMore restrictive than Expected" | Out-String
                            $FindingDetails += "Compliance:`tCompliant" | Out-String
                        }
                        Else {
                            $AllCompliant = $false
                            $FindingDetails += "OverallState:`tLess restrictive than Expected [finding]" | Out-String
                            $FindingDetails += "Compliance:`tNot Compliant" | Out-String
                        }
                        $FindingDetails += "Unexpected rules..." | Out-String
                        $i = 1
                        $FindingDetails += "---------------------" | Out-String
                        foreach ($Rule in $UnexpectedRules) {
                            $FindingDetails += "State:`t`t$($Rule.ActualState)" | Out-String
                            if ($Rule.ActualState -eq "LessRestrictive") {
                                $FindingDetails += "Compliant:`t$($false)" | Out-String
                            }
                            else {
                                $FindingDetails += "Compliant:`t$($true)" | Out-String
                            }
                            $FindingDetails += "Identity:`t`t$($Rule.IdentityReference)" | Out-String
                            $FindingDetails += "Type:`t`t$($Rule.ActualAccessControlType)" | Out-String
                            $FindingDetails += "Basic:`t`t$($Rule.ActualBasicRights)" | Out-String
                            $FindingDetails += "Expected:`t`t$($Rule.ExpectedBasicRights)" | Out-String
                            $FindingDetails += "Advanced:`t$(($Rule.ActualCanonicalRights | Sort-Object) -join ', ')" | Out-String
                            $FindingDetails += "Expected:`t`t$(($Rule.ExpectedCanonicalRights | Sort-Object) -join ', ')" | Out-String
                            $FindingDetails += "Inherited:`t`t$($Rule.ActualInheritedFrom)" | Out-String
                            $FindingDetails += "AppliesTo:`t$($Rule.ActualAppliesTo -join ', ')" | Out-String
                            $FindingDetails += "Summary:`t`t$($Rule.Summary)" | Out-String
                            if ($i -lt ($UnexpectedRules | Measure-Object).Count) {
                                $FindingDetails += "" | Out-String
                            }
                            $i++
                        }
                        $FindingDetails += "---------------------" | Out-String
                    }
                }
            }
            Else {
                $AllCompliant = $false
                $FindingDetails += "Path:`t`t$($Path)" | Out-String
                $FindingDetails += "---------------------" | Out-String
                $FindingDetails += "Log file not found." | Out-String
            }
        }
        If ($AllCompliant -eq $true) {
            $Status = "NotAFinding"
        }
    }
    #---=== End Custom Code ===---#

    if ($FindingDetails.Trim().Length -gt 0) {
        $ResultHash = Get-TextHash -Text $FindingDetails.Trim() -Algorithm SHA1
    }
    else {
        if  ($Status -ne "Not_Reviewed") {
            throw "Attempt to set Status without providing Finding Details."
        }
        $ResultHash = ""
    }

    if ($PSBoundParameters.AnswerFile) {
        $GetCorpParams = @{
            AnswerFile   = $PSBoundParameters.AnswerFile
            VulnID       = $VulnID
            RuleID       = $RuleID
            AnswerKey    = $PSBoundParameters.AnswerKey
            Status       = $Status.Trim()
            Hostname     = $Hostname
            Username     = $Username
            UserSID      = $UserSID
            Instance     = $Instance
            Database     = $Database
            Site         = $Site
            ResultHash   = $ResultHash
            ResultData   = $FindingDetails.Trim()
            ShowRun      = $ShowRunningConfig
            ESPath       = $ESPath
            LogPath      = $LogPath
            LogComponent = $LogComponent
            OSPlatform   = $OSPlatform
        }

        $AnswerData = (Get-CorporateComment @GetCorpParams)
        if ($Status -eq $AnswerData.ExpectedStatus) {
            $SendAnswerData = $AnswerData
        }
    }

    $SendCheckParams = @{
        Module           = $ModuleName
        Status           = $Status.Trim()
        FindingDetails   = $FindingDetails.Trim()
        AnswerData       = $SendAnswerData
        SeverityOverride = $SeverityOverride
        Justification    = $Justification
        HeadInstance     = $Instance
        HeadDatabase     = $Database
        HeadSite         = $Site
        HeadHash         = $ResultHash
    }
    if ($AF_UserHeader) {
        $SendCheckParams.Add("HeadUsername", $Username)
        $SendCheckParams.Add("HeadUserSID", $UserSID)
    }

    return Send-CheckResult @SendCheckParams
