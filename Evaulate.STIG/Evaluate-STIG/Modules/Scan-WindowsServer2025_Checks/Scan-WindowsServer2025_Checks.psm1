        [Parameter(Mandatory = $false)]
        [String]$SiteName
    )

    $ModuleName = (Get-Command $MyInvocation.MyCommand).Source
    $FuncDescription = ($MyInvocation.MyCommand.ScriptBlock -split "#>")[0].split("`r`n")
    $VulnID = ($FuncDescription | Select-String -Pattern "V-\d{4,6}$").Matches[0].Value
    $RuleID = ($FuncDescription | Select-String -Pattern "SV-\d{4,6}r\d{1,}_rule$").Matches[0].Value
    $Status = "Not_Reviewed"  # Acceptable values are 'Not_Reviewed', 'Open', 'NotAFinding', 'Not_Applicable'
    $FindingDetails = ""
    $SeverityOverride = ""  # Acceptable values are 'CAT_I', 'CAT_II', 'CAT_III'.  Only use if STIG calls for a severity change based on specified critera.
    $Justification = ""  # If SeverityOverride is used, a justification is required.
    # $ResultObject = [System.Collections.Generic.List[System.Object]]::new()

    #---=== Begin Custom Code ===---#
    $DomainRole = Get-DomainRoleStatus
    If (-Not($DomainRole.RoleFriendlyName -in @("Backup Domain Controller", "Primary Domain Controller"))) {
        $Status = "Not_Applicable"
        $FindingDetails += "System is a '$($DomainRole.RoleFriendlyName)' so this requirement is NA." | Out-String
    }
    Else {
        $AllCompliant = $true

        $AclToEval = @(
            # CREATOR OWNER
            @{IdentityReference = "CREATOR OWNER"; AccessControlType = "Allow"; CanonicalRights = @("Self")},
            # SELF
            @{IdentityReference = "NT AUTHORITY\SELF"; AccessControlType = "Allow"; CanonicalRights = @("Self")},
            @{IdentityReference = "NT AUTHORITY\SELF"; AccessControlType = "Allow"; CanonicalRights = @("WriteProperty")},
            @{IdentityReference = "NT AUTHORITY\SELF"; AccessControlType = "Allow"; CanonicalRights = @("ReadProperty", "WriteProperty")},
            @{IdentityReference = "NT AUTHORITY\SELF"; AccessControlType = "Allow"; CanonicalRights = @("ExtendedRight", "ReadProperty", "WriteProperty")},
            # Authenticated Users
            @{IdentityReference = "NT AUTHORITY\Authenticated Users"; AccessControlType = "Allow"; CanonicalRights = @("ListChildren", "ListObject", "ReadPermissions", "ReadProperty")},
            # SYSTEM
            @{IdentityReference = "NT AUTHORITY\SYSTEM"; AccessControlType = "Allow"; BasicRights = @("FullControl")},
            # Domain Admins
            @{IdentityReference = (Get-ADGroup -Identity ('{0}-512' -f (Get-ADDomain).DomainSID)).Sid.Translate([System.Security.Principal.NTAccount]).Value; AccessControlType = "Allow"; CanonicalRights = @("CreateChild", "ExtendedRight", "ListChildren", "ListObject", "ReadPermissions", "ReadProperty", "Self", "WriteOwner", "WritePermissions", "WriteProperty")},
            # Enterprise Admins
            @{IdentityReference = (Get-ADGroup -Identity ('{0}-519' -f (Get-ADDomain -Identity (Get-ADForest).RootDomain).DomainSID) -Server (Get-ADForest).RootDomain).Sid.Translate([System.Security.Principal.NTAccount]).Value; AccessControlType = "Allow"; BasicRights = @("FullControl")},
            # Key Admins
            @{IdentityReference = (Get-ADGroup -Identity ('{0}-526' -f (Get-ADDomain).DomainSID)).Sid.Translate([System.Security.Principal.NTAccount]).Value; AccessControlType = "Allow"; CanonicalRights = @("ReadProperty", "WriteProperty")},
            # Enterprise Key Admins
            @{IdentityReference = (Get-ADGroup -Identity ('{0}-527' -f (Get-ADDomain -Identity (Get-ADForest).RootDomain).DomainSID) -Server (Get-ADForest).RootDomain).Sid.Translate([System.Security.Principal.NTAccount]).Value; AccessControlType = "Allow"; CanonicalRights = @("ReadProperty", "WriteProperty")},
            # Administrators
            @{IdentityReference = "BUILTIN\Administrators"; AccessControlType = "Allow"; CanonicalRights = @("CreateChild", "Delete", "ExtendedRight", "ListChildren", "ListObject", "ReadPermissions", "ReadProperty", "Self", "WriteOwner", "WritePermissions", "WriteProperty")},
            # Pre-Windows 2000 Compatible Access
            @{IdentityReference = "BUILTIN\Pre-Windows 2000 Compatible Access"; AccessControlType = "Allow"; CanonicalRights = @("ListChildren", "ListObject", "ReadPermissions", "ReadProperty")},
            @{IdentityReference = "BUILTIN\Pre-Windows 2000 Compatible Access"; AccessControlType = "Allow"; CanonicalRights = @("ListChildren")},
            @{IdentityReference = "BUILTIN\Pre-Windows 2000 Compatible Access"; AccessControlType = "Allow"; CanonicalRights = @("ReadProperty"); ObjectType = "037088f8-0ae1-11d2-b422-00a0c968f939"},
            @{IdentityReference = "BUILTIN\Pre-Windows 2000 Compatible Access"; AccessControlType = "Allow"; CanonicalRights = @("ReadProperty"); ObjectType = "4c164200-20c0-11d0-a768-00aa006e0529"},
            @{IdentityReference = "BUILTIN\Pre-Windows 2000 Compatible Access"; AccessControlType = "Allow"; CanonicalRights = @("ReadProperty"); ObjectType = "59ba2f42-79a2-11d0-9020-00c04fc2d3cf"},
            @{IdentityReference = "BUILTIN\Pre-Windows 2000 Compatible Access"; AccessControlType = "Allow"; CanonicalRights = @("ReadProperty"); ObjectType = "5f202010-79a5-11d0-9020-00c04fc2d4cf"},
            @{IdentityReference = "BUILTIN\Pre-Windows 2000 Compatible Access"; AccessControlType = "Allow"; CanonicalRights = @("ReadProperty"); ObjectType = "bc0ac240-79a9-11d0-9020-00c04fc2d4cf"},
            # ENTERPRISE DOMAIN CONTROLLERS
            @{IdentityReference = "NT AUTHORITY\ENTERPRISE DOMAIN CONTROLLERS"; AccessControlType = "Allow"; CanonicalRights = @("ListChildren", "ListObject", "ReadPermissions", "ReadProperty")},
            @{IdentityReference = "NT AUTHORITY\ENTERPRISE DOMAIN CONTROLLERS"; AccessControlType = "Allow"; CanonicalRights = @("ReadProperty")}
        )

        Import-Module ActiveDirectory
        $Object = Get-ADObject -Filter {ObjectClass -eq 'organizationalUnit' -and Name -eq 'Domain Controllers'} -IncludeDeletedObjects | Where-Object Deleted -ne $true

        $AclCheck = Test-AclCompliance -Path "AD:$($Object.DistinguishedName)" -ExpectedAcl $AclToEval

        $FindingDetails += "OU DN:`t`t$($Object.DistinguishedName)" | Out-String
        switch ($AclCheck.OverallState) {
            "Same" {
                $FindingDetails += "OverallState:`tExpected permissions in place" | Out-String
                $FindingDetails += "Compliance:`tCompliant" | Out-String
            }
            {$_ -in @("MoreRestrictive", "LessRestrictive")} {
                $UnexpectedRules = $AclCheck.Details.Access | Where-Object {$_.ActualState -in @("MoreRestrictive", "LessRestrictive")}
                If ($_ -eq "MoreRestrictive") {
                    $FindingDetails += "OverallState:`tMore restrictive than Expected" | Out-String
                    $FindingDetails += "Compliance:`tCompliant" | Out-String
                }
                Else {
                    $AllCompliant = $false
                    $FindingDetails += "OverallState:`tLess restrictive than Expected [finding]" | Out-String
                    $FindingDetails += "Compliance:`tNot Compliant" | Out-String
                }
                $FindingDetails += "Unexpected rules..." | Out-String
                $i = 1
                $FindingDetails += "---------------------" | Out-String
                foreach ($Rule in $UnexpectedRules) {
                    $FindingDetails += "State:`t`t$($Rule.ActualState)" | Out-String
                    if ($Rule.ActualState -eq "LessRestrictive") {
                        $FindingDetails += "Compliant:`t$($false)" | Out-String
                    }
                    else {
                        $FindingDetails += "Compliant:`t$($true)" | Out-String
                    }
                    $FindingDetails += "Identity:`t`t$($Rule.IdentityReference)" | Out-String
                    $FindingDetails += "Type:`t`t$($Rule.ActualAccessControlType)" | Out-String
                    $FindingDetails += "Basic:`t`t$($Rule.ActualBasicRights)" | Out-String
                    $FindingDetails += "Expected:`t`t$($Rule.ExpectedBasicRights)" | Out-String
                    $FindingDetails += "Advanced:`t$(($Rule.ActualCanonicalRights | Sort-Object) -join ', ')" | Out-String
                    $FindingDetails += "Expected:`t`t$(($Rule.ExpectedCanonicalRights | Sort-Object) -join ', ')" | Out-String
                    $FindingDetails += "Inherited:`t`t$($Rule.ActualInheritedFrom)" | Out-String
                    $FindingDetails += "AppliesTo:`t$($Rule.ActualAppliesTo -join ', ')" | Out-String
                    $FindingDetails += "Summary:`t`t$($Rule.Summary)" | Out-String
                    if ($i -lt ($UnexpectedRules | Measure-Object).Count) {
                        $FindingDetails += "" | Out-String
                    }
                    $i++
                }
                $FindingDetails += "---------------------" | Out-String
            }
        }

        If ($AllCompliant -eq $true) {
            $Status = "NotAFinding"
        }
        Else {
            $Status = "Open"
        }
    }
    #---=== End Custom Code ===---#

    if ($FindingDetails.Trim().Length -gt 0) {
        $ResultHash = Get-TextHash -Text $FindingDetails.Trim() -Algorithm SHA1
    }
    else {
        if  ($Status -ne "Not_Reviewed") {
            throw "Attempt to set Status without providing Finding Details."
        }
        $ResultHash = ""
    }

    if ($PSBoundParameters.AnswerFile) {
        $GetCorpParams = @{
            AnswerFile   = $PSBoundParameters.AnswerFile
            VulnID       = $VulnID
            RuleID       = $RuleID
            AnswerKey    = $PSBoundParameters.AnswerKey
            Status       = $Status.Trim()
            Hostname     = $Hostname
            Username     = $Username
            UserSID      = $UserSID
            Instance     = $Instance
            Database     = $Database
            Site         = $Site
            ResultHash   = $ResultHash
            ResultData   = $FindingDetails.Trim()
            ShowRun      = $ShowRunningConfig
            ESPath       = $ESPath
            LogPath      = $LogPath
            LogComponent = $LogComponent
            OSPlatform   = $OSPlatform
        }

        $AnswerData = (Get-CorporateComment @GetCorpParams)
        if ($Status -eq $AnswerData.ExpectedStatus) {
            $SendAnswerData = $AnswerData
        }
    }

    $SendCheckParams = @{
        Module           = $ModuleName
        Status           = $Status.Trim()
        FindingDetails   = $FindingDetails.Trim()
        AnswerData       = $SendAnswerData
        SeverityOverride = $SeverityOverride
        Justification    = $Justification
        HeadInstance     = $Instance
        HeadDatabase     = $Database
        HeadSite         = $Site
        HeadHash         = $ResultHash
    }
    if ($AF_UserHeader) {
        $SendCheckParams.Add("HeadUsername", $Username)
        $SendCheckParams.Add("HeadUserSID", $UserSID)
    }

    return Send-CheckResult @SendCheckParams
}

