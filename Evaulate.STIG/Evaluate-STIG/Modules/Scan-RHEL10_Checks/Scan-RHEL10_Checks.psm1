            $Status = "Open"
            $FindingMessage = "The SSH daemon does allows $option authentication either due to an incorrect setting or the file does not lexicographically precede 50-redhat.conf ."
        }
    }
    else {
        $Status = "Open"
        $FindingMessage = "The SSH daemon does allows $option authentication in a drop-in file."
